2026-10-18T18:38:56.9989248Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-18T18:38:56.9989565Z 
2026-10-18T18:38:56.9989807Z # To enable the settings / commands in this file for login shells as well,
2026-10-18T18:38:56.9990316Z # this file has to be sourced in /etc/profile.
2026-10-18T18:38:56.9990575Z 
2026-10-18T18:38:56.9990728Z # If not running interactively, don't do anything
2026-10-18T18:38:56.9991101Z [ -z "$PS1" ] && return
2026-10-18T18:38:56.9991644Z 
2026-10-18T18:38:56.9991837Z # check the window size after each command and, if necessary,
2026-10-18T18:38:56.9992267Z # update the values of LINES and COLUMNS.
2026-10-18T18:38:56.9992618Z shopt -s checkwinsize
2026-10-18T18:38:56.9992791Z 
2026-10-18T18:38:56.9993056Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-18T18:38:56.9993669Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-18T18:38:56.9994098Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-18T18:38:56.9994457Z fi
2026-10-18T18:38:56.9994582Z 
2026-10-18T18:38:56.9994804Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-18T18:38:56.9995351Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-18T18:38:56.9995669Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-18T18:38:56.9995937Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-18T18:38:56.9996211Z fi
2026-10-18T18:38:56.9996303Z 
2026-10-18T18:38:56.9996460Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
