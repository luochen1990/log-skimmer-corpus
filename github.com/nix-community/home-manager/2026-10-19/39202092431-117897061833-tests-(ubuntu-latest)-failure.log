2026-10-19T04:58:06.5430894Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-19T04:58:06.5431308Z 
2026-10-19T04:58:06.5431685Z # To enable the settings / commands in this file for login shells as well,
2026-10-19T04:58:06.5432488Z # this file has to be sourced in /etc/profile.
2026-10-19T04:58:06.5433289Z 
2026-10-19T04:58:06.5433507Z # If not running interactively, don't do anything
2026-10-19T04:58:06.5434907Z [ -z "$PS1" ] && return
2026-10-19T04:58:06.5435156Z 
2026-10-19T04:58:06.5435447Z # check the window size after each command and, if necessary,
2026-10-19T04:58:06.5436047Z # update the values of LINES and COLUMNS.
2026-10-19T04:58:06.5436521Z shopt -s checkwinsize
2026-10-19T04:58:06.5436757Z 
2026-10-19T04:58:06.5437123Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-19T04:58:06.5437937Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-19T04:58:06.5438545Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-19T04:58:06.5439071Z fi
2026-10-19T04:58:06.5439232Z 
2026-10-19T04:58:06.5439537Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-19T04:58:06.5440061Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-19T04:58:06.5440476Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-19T04:58:06.5440838Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-19T04:58:06.5441157Z fi
2026-10-19T04:58:06.5441254Z 
2026-10-19T04:58:06.5441476Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
